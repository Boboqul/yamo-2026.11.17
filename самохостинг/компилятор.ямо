// === КОНСТАНТЫ ===
целое БАЗА;
целое ЗАГОЛОВКИ;
целое СТРАНИЦА;

// === ВСПОМОГАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ ===
целое источник;
целое размер;
целое позиция;
целое код;
целое данные;
целое файл;
целое размер_кода;
целое размер_данных;
целое сегмент_код;
целое база_данных;
целое всего;
целое ph1;
целое ph2;
целое адрес;
целое i;

// === ЧИТАТЕЛЬ ===
функция это_буква(целое символ) {
    если символ >= 65 {
        если символ <= 90 {
            вернуть 1;
        }
    }
    
    если символ >= 97 {
        если символ <= 122 {
            вернуть 1;
        }
    }
    
    если символ >= 128 {
        вернуть 1;
    }
    
    если символ == 95 {
        вернуть 1;
    }
    
    вернуть 0;
}

функция это_цифра(целое символ) {
    если символ >= 48 {
        если символ <= 57 {
            вернуть 1;
        }
    }
    
    вернуть 0;
}

функция это_часть_слова(целое символ) {
    если это_буква(символ) {
        вернуть 1;
    }
    
    если это_цифра(символ) {
        вернуть 1;
    }
    
    вернуть 0;
}

функция читатель_открыть(целое имя) {
    размер = размер_файла(имя);
    источник = новый массив байт(размер);
    прочитать_файл(имя, источник, размер);
    позиция = 0;
    вернуть 0;
}

функция читатель_пропустить_пробелы() {
    целое символ;
    
    пока позиция < размер {
        символ = источник[позиция];
        
        если символ == 32 {
            позиция = позиция + 1;
        } иначе {
            если символ == 10 {
                позиция = позиция + 1;
            } иначе {
                если символ == 9 {
                    позиция = позиция + 1;
                } иначе {
                    вернуть 0;
                }
            }
        }
    }
    
    вернуть 0;
}

функция читатель_читать_слово() {
    целое начало;
    целое символ;
    
    читатель_пропустить_пробелы();
    
    если позиция >= размер {
        вернуть -1;
    }
    
    начало = позиция;
    
    пока позиция < размер {
        символ = источник[позиция];
        
        если это_часть_слова(символ) {
            позиция = позиция + 1;
        } иначе {
            вернуть начало;
        }
    }
    
    вернуть начало;
}

// === ЭМИТТЕР (x86-64) ===
функция эмит_байт(целое значение) {
    добавить_байт(код, значение);
    вернуть 0;
}

функция эмит_слово4(целое значение) {
    целое номер;
    целое текущее;
    целое остаток;
    
    номер = 0;
    текущее = значение;
    
    пока (номер < 4) {
        остаток = текущее - (текущее / 256) * 256;
        добавить_байт(код, остаток);
        текущее = текущее / 256;
        номер = номер + 1;
    }
    
    вернуть 0;
}

// === ГЕНЕРАТОР КОДА ===
функция сгенерировать_выход(целое код_возврата) {
    // mov eax, 60 (exit syscall)
    эмит_байт(72);
    эмит_байт(199);
    эмит_байт(192);
    эмит_слово4(60);
    
    // mov edi, код_возврата
    эмит_байт(72);
    эмит_байт(199);
    эмит_байт(199);
    эмит_слово4(код_возврата);
    
    // syscall
    эмит_байт(15);
    эмит_байт(5);
    
    вернуть 0;
}

// === ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ДЛЯ ELF ===
функция положить_2(целое буфер, целое смещение, целое значение) {
    добавить_байт(буфер, значение);
    добавить_байт(буфер, значение / 256);
    вернуть 0;
}

функция положить_4(целое буфер, целое смещение, целое значение) {
    целое текущее;
    целое номер;
    целое остаток;
    
    текущее = значение;
    номер = 0;
    
    пока (номер < 4) {
        остаток = текущее - (текущее / 256) * 256;
        добавить_байт(буфер, остаток);
        текущее = текущее / 256;
        номер = номер + 1;
    }
    
    вернуть 0;
}

функция положить_8(целое буфер, целое смещение, целое значение) {
    целое текущее;
    целое номер;
    целое остаток;
    
    текущее = значение;
    номер = 0;
    
    пока (номер < 8) {
        остаток = текущее - (текущее / 256) * 256;
        добавить_байт(буфер, остаток);
        текущее = текущее / 256;
        номер = номер + 1;
    }
    
    вернуть 0;
}

// === ГЕНЕРАТОР ELF ===
функция создать_elf(целое имя_выхода) {
    целое остаток;
    
    размер_кода = длина_буфера(код);
    размер_данных = длина_буфера(данные);
    
    // Сегмент кода = заголовки + код (с выравниванием по странице)
    сегмент_код = ЗАГОЛОВКИ + размер_кода;
    остаток = сегмент_код - (сегмент_код / СТРАНИЦА) * СТРАНИЦА;
    
    пока (остаток != 0) {
        сегмент_код = сегмент_код + 1;
        остаток = сегмент_код - (сегмент_код / СТРАНИЦА) * СТРАНИЦА;
    }
    
    база_данных = БАЗА + сегмент_код;
    всего = сегмент_код + размер_данных;
    
    файл = новый буфер(всего + 64);
    
    // === ELF ЗАГОЛОВОК (64 байта) ===
    добавить_байт(файл, 127);  // 0x7f
    добавить_байт(файл, 69);   // 'E'
    добавить_байт(файл, 76);   // 'L'
    добавить_байт(файл, 70);   // 'F'
    добавить_байт(файл, 2);    // 64-бит
    добавить_байт(файл, 1);    // little-endian
    добавить_байт(файл, 1);    // ELF версия
    добавить_байт(файл, 0);    // OS/ABI
    
    i = 8;
    пока (i < 16) {
        добавить_байт(файл, 0);
        i = i + 1;
    }
    
    положить_2(файл, 16, 2);
    положить_2(файл, 18, 62);
    положить_4(файл, 20, 1);
    положить_8(файл, 24, БАЗА + ЗАГОЛОВКИ);
    положить_8(файл, 32, 64);
    положить_8(файл, 40, 0);
    положить_4(файл, 48, 0);
    положить_2(файл, 52, 64);
    положить_2(файл, 54, 56);
    положить_2(файл, 56, 2);
    положить_2(файл, 58, 0);
    положить_2(файл, 60, 0);
    положить_2(файл, 62, 0);
    
    // === PROGRAM HEADER 1: СЕГМЕНТ КОДА ===
    ph1 = 64;
    
    положить_4(файл, ph1, 1);
    положить_4(файл, ph1 + 4, 5);
    положить_8(файл, ph1 + 8, 0);
    положить_8(файл, ph1 + 16, БАЗА);
    положить_8(файл, ph1 + 24, БАЗА);
    положить_8(файл, ph1 + 32, сегмент_код);
    положить_8(файл, ph1 + 40, сегмент_код);
    положить_8(файл, ph1 + 48, СТРАНИЦА);
    
    // === PROGRAM HEADER 2: СЕГМЕНТ ДАННЫХ ===
    ph2 = 120;
    
    положить_4(файл, ph2, 1);
    положить_4(файл, ph2 + 4, 6);
    положить_8(файл, ph2 + 8, сегмент_код);
    положить_8(файл, ph2 + 16, база_данных);
    положить_8(файл, ph2 + 24, база_данных);
    положить_8(файл, ph2 + 32, размер_данных);
    положить_8(файл, ph2 + 40, размер_данных);
    положить_8(файл, ph2 + 48, СТРАНИЦА);
    
    // === ДОБАВЛЯЕМ МАШИННЫЙ КОД ===
    адрес = данные_буфера(код);
    i = 0;
    пока (i < размер_кода) {
        добавить_байт(файл, адрес[i]);
        i = i + 1;
    }
    
    // === ДОБАВЛЯЕМ ДАННЫЕ ===
    если размер_данных > 0 {
        адрес = данные_буфера(данные);
        i = 0;
        пока (i < размер_данных) {
            добавить_байт(файл, адрес[i]);
            i = i + 1;
        }
    }
    
    // === ЗАПИСЫВАЕМ ФАЙЛ ===
    записать_файл(имя_выхода, данные_буфера(файл), длина_буфера(файл));
    
    вывод "создан_ELF:";
    вывод имя_выхода;
    вывод "размер:";
    вывод длина_буфера(файл);
    
    вернуть 0;
}

// === ГЛАВНАЯ ФУНКЦИЯ ===
БАЗА = 4194304;
ЗАГОЛОВКИ = 176;
СТРАНИЦА = 4096;

код = новый буфер(4096);
данные = новый буфер(4096);

// Генерируем простую программу: выход с кодом 42
сгенерировать_выход(42);

вывод "длина_кода:";
вывод длина_буфера(код);

создать_elf("тест.elf");
